export interface GrammarExample {
    jp: string;
    vn: string;
}

export interface GrammarItem {
    id: number;
    level: 'N5' | 'N4';
    group: string;
    label: string; // The specific grammar point e.g. "~です"
    meaning: string;
    examples: GrammarExample[];
    note?: string; // For extra context like "Groups 1, 2, 3"
}

